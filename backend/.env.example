# Financial Modeling Prep primary API key.
# Do not commit your real key.
FMP_API_KEY=

# Optional backup keys. The backend uses key 2 only when key 1 hits
# a quota/rate-limit response, and key 3 only when keys 1 and 2 both hit
# quota/rate-limit responses. They are not used for invalid symbols or endpoint errors.
FMP_API_KEY_2=
FMP_API_KEY_3=

# If 1, FMP statement data is required when the FMP tab explicitly needs statements.
# The FMP Direct DCF tab does not require statement endpoints.
FMP_ONLY=1

# If 1, the headline fair value in the FMP tab uses FMP's own prebuilt DCF endpoint.
# The assumptions/projection panels still show the app's transparent internal diagnostic model.
FMP_DIRECT_DCF=1

# Keep off by default to protect quota. Set to 1 only if you want FMP for chart price history.
FMP_PRICE_HISTORY=0

# Backend cache. Default is 6 hours. This prevents repeated users/tabs/manual
# recalculations of the same ticker from spending new FMP calls.
APP_CACHE_TTL_SECONDS=21600

# Optional shared cache for Vercel/serverless/multiple users.
# Without this, cache is process memory only and may reset on deploy/cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
