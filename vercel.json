{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "backend/**",
        "frontend/dist/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}